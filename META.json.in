{
  "name": "pg_pinecone",
  "abstract": "Pinecone vector search inside PostgreSQL",
  "description": "pg_pinecone brings Pinecone vector search into PostgreSQL. Index a vector column with the native engine, pgvector, or a remote Pinecone serverless index, and keep a Pinecone full-text index in sync with a table.",
  "version": "@CARGO_VERSION@",
  "maintainer": [
